#
# A systemd generator (run at boot and at every `systemctl daemon-reload`): the folders plugin-hostd searches, as
# `plugin-hostd --search-path -c <hostd_conf>` prints them, become PathChanged= lines of plugin-qualify-sync.path,
# beside the standard folders the unit itself names. The unit carries no folder of any one distribution; plugin-hostd's
# settings file is the one place a machine's extra folders are written.
#
#   plugin-qualify-sync-generator <normal-dir> [<early-dir> <late-dir>]
#
# PLUGIN_QUALIFY_CONF names the settings file (default /etc/omx/qualify.conf), PLUGIN_HOSTD the daemon binary.

out=${1:?usage: plugin-qualify-sync-generator <normal-dir>}
conf=${PLUGIN_QUALIFY_CONF:-/etc/omx/qualify.conf}
hostd_conf=
[ -r "$conf" ] && hostd_conf=$(awk '{ sub(/#.*/, "") } $1 == "hostd_conf" { v = $0; sub(/^[ \t]*[^ \t]+[ \t]*/, "", v); sub(/[ \t]+$/, "", v); print v }' "$conf" | tail -n 1)

dirs=$(${PLUGIN_HOSTD:-plugin-hostd} ${hostd_conf:+-c "$hostd_conf"} --search-path 2>/dev/null | awk -F '\t' '
	($1 == "lv2" || $1 == "clap") && $2 == "effective" {
		n = split($3, d, ":")
		for (i = 1; i <= n; i++) if (d[i] ~ /^\/[^ \t]*$/ && !seen[d[i]]++) print d[i]
	}')
[ -n "$dirs" ] || exit 0

mkdir -p "$out/plugin-qualify-sync.path.d" || exit 0
{
	echo "# generated from plugin-hostd --search-path${hostd_conf:+ -c $hostd_conf} by plugin-qualify-sync-generator; edit plugin-hostd's settings and run systemctl daemon-reload"
	echo "[Path]"
	for d in $dirs; do echo "PathChanged=$d"; done
} > "$out/plugin-qualify-sync.path.d/50-qualify-conf.conf"
exit 0
